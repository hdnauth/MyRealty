# ───────── 공통 ─────────
DATABASE_URL=postgresql://myrealty:myrealty@localhost:5432/myrealty
APP_URL=http://localhost:3000

# ───────── 인증 (이메일 OTP) ─────────
# openssl rand -base64 32 로 생성
AUTH_SECRET=
# 로그인 허용 이메일(쉼표 구분). 설정 화면에서 DB 허용 목록에도 추가 가능
ALLOWED_EMAILS=you@example.com

# 메일 발송(SMTP). 비워두면 코드가 서버 로그에 출력됨(개발용)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MyRealty <no-reply@example.com>

# ───────── 공공 데이터 ─────────
# 공공데이터포털 일반 인증키(Decoding) — 실거래가 11종, 건축물대장, 청약홈 분양정보
DATA_GO_KR_KEY=
# 개발계정 서비스별 일일 한도보다 약간 낮게
QUOTA_DATA_GO_KR=900
# 행정안전부 도로명주소 검색 API 승인키
JUSO_KEY=
# 브이월드(토지이용계획·토지특성·공시지가·지오코딩 보조)
VWORLD_KEY=
VWORLD_DOMAIN=
# 한국은행 ECOS / KOSIS / 한국부동산원 R-ONE
ECOS_KEY=
KOSIS_KEY=
REB_KEY=

# ───────── 네이버 ─────────
# 네이버 클라우드 플랫폼 Maps Application (Client ID / Client Secret) — 지도 표시 + 지오코딩
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=
# 네이버 개발자센터 검색 API(뉴스)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ───────── AI (Claude) ─────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# 뉴스 분류 등 대량 배치용 모델(비용을 줄이려면 claude-haiku-4-5)
ANTHROPIC_BULK_MODEL=claude-opus-5
# 월 AI 예산(USD). 초과 시 배치 작업 보류
AI_MONTHLY_BUDGET_USD=30

# ───────── 웹푸시 (VAPID) ─────────
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ───────── 스케줄 ─────────
# /api/cron/reports 호출 인증(GitHub Actions reports.yml 이 사용)
CRON_SECRET=
