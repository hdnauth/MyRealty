# ───────── 공통 ─────────
DATABASE_URL=postgresql://myrealty:myrealty@localhost:5432/myrealty
APP_URL=http://localhost:3000

# ───────── 인증 (이메일 OTP) · 관리자 ─────────
# openssl rand -base64 32 로 생성 (필수)
AUTH_SECRET=
# 관리자 계정 이메일(쉼표 구분). 로그인하면 사이드바·메뉴에 "관리"(/admin)가 보인다.
# 가입 방식과 무관하게 로그인할 수 있고, 화면에서 정지·강등·삭제할 수 없다.
ADMIN_EMAILS=you@example.com
# (선택) 관리 화면에서 가입 방식을 "허용 목록만"으로 바꿨을 때 추가로 허용할 이메일.
# 기본 가입 방식은 "누구나 가입"이라 비워 둬도 된다.
ALLOWED_EMAILS=

# 메일 발송(SMTP). 비워두면 코드가 서버 로그에 출력됨(개발용)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MyRealty <no-reply@example.com>

# ───────── 공공 데이터 ─────────
# 공공데이터포털 일반 인증키(Decoding) — 실거래가 11종, 건축물대장, 청약홈 분양정보
# 웹에도 넣으면 부동산 등록 때 건축물대장으로 유형·평형·동·호·면적을 자동으로 채운다('건축HUB 건축물대장정보' 활용신청 필요)
DATA_GO_KR_KEY=
# 개발계정 서비스별 일일 한도보다 약간 낮게
QUOTA_DATA_GO_KR=900
# 행정안전부 도로명주소 검색 API 승인키
JUSO_KEY=
# 브이월드(토지이용계획·토지특성·공시지가·지오코딩 보조, 토지 등록 시 지목·면적 자동 입력, 네이버 키가 없을 때 대체 지도 배경)
VWORLD_KEY=
VWORLD_DOMAIN=
# 한국은행 ECOS / KOSIS / 한국부동산원 R-ONE
ECOS_KEY=
KOSIS_KEY=
REB_KEY=

# ───────── 네이버 ─────────
# 네이버 클라우드 플랫폼 Maps Application (Client ID / Client Secret) — 지도 표시 + 지오코딩
# Application 에서 Dynamic Map·Geocoding 선택, Web 서비스 URL 에 배포 도메인 등록. 없으면 대체 지도(브이월드/OSM)로 표시
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=
# 네이버 검색(뉴스) — 둘 중 하나의 Client ID/Secret(형식으로 자동 판별, 인증 실패 시 다른 쪽도 시도)
#   · 네이버 클라우드 NAVER API HUB(검색 API 연결): ID 10자·Secret 40자, naverapihub.apigw.ntruss.com
#   · 네이버 개발자센터(developers.naver.com) 검색 API: ID 20자·Secret 10자, openapi.naver.com
# 지도용 NCP_MAPS_KEY_ID 와는 다른 키다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ───────── AI ─────────
# 서버 기본 AI(Claude). 사용자는 설정 › AI 모델에서 본인 키로 Claude·GPT·Gemini·DeepSeek·MiMo·Ollama 를 고를 수 있다
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# 뉴스 분류 등 대량 배치용 모델(비용을 줄이려면 claude-haiku-4-5)
ANTHROPIC_BULK_MODEL=claude-opus-5
# 동네 이야기 자동 검토(새 글·댓글)용 모델. 질문 글 AI 첫 답변은 ANTHROPIC_MODEL 을 쓴다(관리 › 사이트 설정에서 끌 수 있음)
COMMUNITY_AI_MODEL=claude-haiku-4-5
# 월 AI 예산(USD). 초과 시 배치 작업 보류(동네 이야기 자동 검토·첫 답변도 멈추고 규칙 점검만 동작)
AI_MONTHLY_BUDGET_USD=30
# 사용자 AI 키 암호화 비밀값(비우면 AUTH_SECRET 에서 파생). 바꾸면 사용자가 키를 다시 입력해야 한다
AI_KEY_SECRET=

# ───────── 웹푸시 (VAPID) ─────────
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ───────── 관심 부동산 개별 수집(등록 직후 바로 채우기) ─────────
# 웹(Vercel)에 넣으면 부동산을 등록하거나 빈 데이터가 있는 부동산을 열 때 GitHub Actions(ETL item)로 그 부동산만 바로 수집한다.
# 토큰: GitHub › Settings › Developer settings › Fine-grained token — 이 리포만, 권한 Actions: Read and write
GITHUB_DISPATCH_TOKEN=
# owner/repo (예: hdnauth/MyRealty), 실행할 브랜치(기본 main)
GITHUB_DISPATCH_REPO=
GITHUB_DISPATCH_REF=main
# 로컬 개발: 1 이면 GitHub 대신 services/etl 에서 `uv run myrealty item` 을 직접 실행
ITEM_COLLECT_LOCAL=
# 지도 "이 지역 데이터 모으기"로 바로 켜 주는 수집 대상(시군구) 상한(기본 40). 넘으면 요청만 남고 운영자가 켠다
REGION_TARGET_CAP=

# ───────── 스케줄 ─────────
# /api/cron/reports 호출 인증(GitHub Actions reports.yml 이 사용)
CRON_SECRET=

# (선택) 개발 서버를 사설망(192.168.x.x·10.x.x.x·172.16~31.x.x·*.local) 밖의 주소로 열 때 허용할 호스트명(쉼표 구분)
# 사설망 주소는 기본 허용 — 같은 와이파이의 휴대폰에서 http://192.168.x.x:3000 으로 열어도 로그인·버튼이 동작한다
#DEV_ORIGINS=

# ───────── Android 앱 · 앱 마켓 (docs/12-android-app.md) ─────────
# 개인정보처리방침·약관(/legal/*)에 표시할 운영자 이름과 문의 이메일. Play Console 개발자 이름·연락처와 맞춘다
OPERATOR_NAME=
SUPPORT_EMAIL=
# TWA 도메인 인증(/.well-known/assetlinks.json). 지문은 쉼표 구분 — 업로드 키 + Play 앱 서명 키(Play Console › 앱 무결성)
ANDROID_PACKAGE_NAME=com.yarch.myrealty
ANDROID_CERT_SHA256=
# 심사용 계정: 이 이메일은 메일 대신 고정 6자리 코드로 로그인(관리자 이메일에는 동작하지 않음). 심사가 끝나면 비운다
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=
